{
  "name": "sliver-implant-dev",
  "build_id": "dev-local",
  "strategy": "s",
  "beacon": false,
  "poll_timeout": 0,
  "reconnect_interval_ns": 60000000000,
  "beacon_interval_ns": 0,
  "beacon_jitter_ns": 0,
  "max_connection_errors": 1000,
  "features": { "mtls": true, "http": false, "dns": false, "wg": false, "pivot": false },
  "c2": [ { "url": "mtls://127.0.0.1:8888" } ],
  "limits": {
    "domain_joined": false,
    "datetime": "",
    "hostname": "",
    "username": "",
    "file_exists": "",
    "locale": ""
  },
  "http": {
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
    "nonce_query_arg_chars": "abcdef0123456789",
    "nonce_query_arg_length": 6,
    "nonce_mode": "query",
    "headers": [
      { "method": "GET", "name": "Accept", "value": "text/html", "probability": 100 },
      { "method": "POST", "name": "Content-Type", "value": "application/octet-stream", "probability": 100 }
    ],
    "url_parameters": [
      { "method": "GET", "name": "session", "value": "abc123", "probability": 100 }
    ],
    "path_segments": [
      { "is_file": false, "value": "api" },
      { "is_file": true, "value": "index" }
    ],
    "extensions": [ "php", "jsp" ],
    "min_path_length": 3,
    "max_path_length": 8,
    "min_file_gen": 1,
    "max_file_gen": 4
  },
  "secrets": {
    "peer_public_key": "",
    "peer_private_key": "",
    "peer_public_key_signature": "",
    "age_server_public_key": "",
    "minisign_server_public_key": "",
    "mtls_ca_cert": "",
    "mtls_cert": "",
    "mtls_key": "",
    "wg_implant_priv_key": "",
    "wg_server_pub_key": "",
    "wg_peer_tun_ip": ""
  }
}
